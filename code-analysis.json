{
  "check": [
    {"name": "pins", "command": ["scripts/dependencies.sh", "check"]},
    {"name": "app", "command": ["hw-odin", "check", "src", "-no-threaded-checker", "-collection:flash=../odin_libraries/hw_odin_ui_flash", "-collection:devlog=../odin_libraries/hw_odin_devlog", "-collection:rune=../hw_odin_rune", "-collection:components=../odin_libraries/hw_odin_ui_components", "-collection:neo=../hw_neobrutalism/neo", "-define:HW_CLIPPER2_LIBRARY=../../build/clipper2/debug/libhw_clipper2.a"]},
    {"name": "cli", "command": ["hw-odin", "check", "src/cli", "-no-threaded-checker", "-collection:devlog=../odin_libraries/hw_odin_devlog", "-define:HW_CLIPPER2_LIBRARY=../../build/clipper2/debug/libhw_clipper2.a"]},
    {"name": "mcp", "command": ["hw-odin", "check", "src/printer_mcp", "-no-threaded-checker", "-collection:devlog=../odin_libraries/hw_odin_devlog"]}
  ],
  "collections": [
    {"name": "flash", "path": "../odin_libraries/hw_odin_ui_flash"},
    {"name": "devlog", "path": "../odin_libraries/hw_odin_devlog"},
    {"name": "rune", "path": "../hw_odin_rune"},
    {"name": "components", "path": "../odin_libraries/hw_odin_ui_components"},
    {"name": "neo", "path": "../hw_neobrutalism/neo"}
  ]
}
