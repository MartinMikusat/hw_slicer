    "verify": "node scripts/verify-site.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.69.3",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "svelte": "5.56.5",
    "svelte-check": "4.4.7",
    "typescript": "6.0.3",
    "vite": "8.1.4"
  }
}
