{
  "name": "hw-slicer-research",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "sync-research": "node scripts/sync-research.mjs",
    "build": "npm run sync-research && vite build",
