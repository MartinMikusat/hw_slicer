{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hw-slicer.invalid/research/catalog.schema.json",
  "title": "HW Slicer research catalog",
  "type": "object",
  "required": ["schemaVersion", "reviewedThrough", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reviewedThrough": { "type": "string", "format": "date" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "citationKey",
        "type",
        "title",
        "authors",
        "year",
        "publication",
        "publisher",
        "doi",
        "url",
        "topics",
        "status",
        "confidence",
        "planSections",
        "summary",
        "keyFindings",
        "limitations",
        "usage",
        "notePath",
        "pdf"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "citationKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]+$" },
        "type": {
          "enum": ["paper", "report", "specification", "documentation"]
        },
        "title": { "type": "string", "minLength": 1 },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "publication": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "volume": { "type": ["string", "null"] },
        "issue": { "type": ["string", "null"] },
        "pages": { "type": ["string", "null"] },
        "doi": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$" }
          ]
        },
        "url": { "type": "string", "format": "uri" },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "status": {
          "enum": ["adopted", "candidate", "background", "rejected", "unreviewed"]
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "planSections": {
          "type": "array",
          "items": { "type": "string", "pattern": "^M(?:[1-9]|1[0-2])$" }
        },
        "summary": { "type": "string", "minLength": 40 },
        "keyFindings": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 20 }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 20 }
        },
        "usage": {
          "type": "object",
          "required": ["decision", "targets"],
          "properties": {
            "decision": { "type": "string", "minLength": 20 },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        "notePath": { "type": "string", "pattern": "^notes/.+\\.md#[a-z0-9-]+$" },
        "pdf": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": [
                "path",
                "sourceUrl",
                "sha256",
                "provenance",
                "accessNote",
                "retrieved"
              ],
              "properties": {
                "path": { "type": "string", "pattern": "^papers/.+\\.pdf$" },
                "sourceUrl": { "type": "string", "format": "uri" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "provenance": { "type": "string", "minLength": 1 },
                "accessNote": { "type": "string", "minLength": 1 },
                "retrieved": { "type": "string", "format": "date" }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
